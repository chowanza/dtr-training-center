# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API, and Project Settings -> Database -> Connection string).
# .env.local is already gitignored — never commit real secrets.

# Postgres connection string. Use the "Transaction pooler" string (port 6543) — that's the
# pgbouncer-fronted one meant for serverless/short-lived connections like Next.js server actions.
DATABASE_URL=

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (server-only — never expose this
# to the browser, never prefix it with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Powers the AI roleplay simulator and the AI knowledge chat ("Ask AI").
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
